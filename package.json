{
  "name": "dotnet-org-cn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "面向中文开发者的 .NET 与 AI 开源社区官网",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "brand:generate": "node scripts/generate-social.mjs && node scripts/generate-brand-assets.mjs",
    "check": "node --test tests/site.test.mjs tests/pages-project.test.mjs tests/project-metadata.test.mjs tests/data-service.test.mjs",
    "data": "node scripts/sync-projects.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name=dotnet-org-cn --branch=main",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
